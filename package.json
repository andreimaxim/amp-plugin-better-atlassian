{
  "name": "@andreimaxim/better-atlassian-mcp",
  "version": "0.1.0",
  "description": "A focused, read-only MCP server for Jira and Confluence Cloud",
  "type": "module",
  "bin": {
    "better-atlassian-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreimaxim/amp-plugin-better-atlassian.git"
  },
  "publishConfig": {
